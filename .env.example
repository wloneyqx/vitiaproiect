DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="svidanie_art"
DATABASE_URL="mysql://root@127.0.0.1:3306/svidanie_art"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
UPLOAD_MAX_BYTES="5242880"
DB_BACKUP_DIR="backups"
CUSTOMER_UPLOAD_DIR="/var/www/svidanie_art/shared/customer-uploads"
NODE_ENV="development"

# Admin panel (/admin). Seed demo: admin@svidanie.art / Admin123!; change after setup.
ADMIN_EMAIL="admin@svidanie.art"
ADMIN_SESSION_SECRET="generate-a-long-random-secret-at-least-32-characters"
JWT_SECRET="generate-a-different-long-random-secret"
PORT="4000"

# Optional order emails through Resend. Leave empty locally if you do not want emails sent.
RESEND_API_KEY=""
EMAIL_FROM="Svidanie Art <orders@your-domain.md>"
ORDER_NOTIFICATION_EMAIL="orders@your-domain.md"
ORDER_EMAILS_ENABLED="true"

# Telegram order notifications and local webhook testing.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ADMIN_USER_ID=""
TELEGRAM_WEBHOOK_SECRET="generate-a-long-random-secret"
